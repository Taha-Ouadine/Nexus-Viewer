# Where the FastAPI backend runs (used by the /api/* rewrite in next.config.mjs)
BACKEND_URL=http://localhost:8000
# Public URL of this site (used for share links / embed code). Optional locally.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional: Supabase (anon key only!). When both are set, job progress uses Supabase
# Realtime; otherwise the browser polls the backend every second.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
