# Copy to backend/.env and fill in. Everything is optional: with no Supabase variables the
# backend uses a local file cache (backend/.cache) and in-memory jobs.

# --- Supabase (server-side only! never put the service-role key in the frontend) ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Web ---
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Archives (defaults shown) ---
# IRSA_TAP_URL=https://irsa.ipac.caltech.edu/TAP
# IRSA_SIA_URL=https://irsa.ipac.caltech.edu/SIA
# S3_HTTPS_BASE=https://nasa-irsa-spherex.s3.us-east-1.amazonaws.com/
# SESAME_URL=https://cds.unistra.fr/cgi-bin/nph-sesame
# GAIA_TAP_URL=https://gea.esac.esa.int/tap-server/tap

# --- How pixels are fetched ---
# FETCH_STRATEGY=range        # range | cutout (IBE cutout service; slower, ~4 MB per exposure)
# RANGE_SOURCE=s3             # where FITS headers are read first: s3 | irsa
# USE_MULTIRANGE=true         # read narrow windows from IRSA with multi-range requests

# --- Limits ---
# MAX_FOV_ARCSEC=1800
# MAX_PARALLEL_CUTOUTS=8      # concurrent requests to IRSA (be polite)
# MAX_PARALLEL_S3=16          # concurrent requests to the AWS open-data bucket
# CUTOUT_TIMEOUT_S=120
# MAX_EXPOSURES_PER_JOB=600
# MAX_PHOTOMETRY_EXPOSURES=600
# EPOCH_GAP_DAYS=30
# BAD_FLAG_BITS=0,1,6,7,9,10,11,14,15,17,19,20,22,23,24,25,26,27,28
# RATE_LIMIT_JOBS=30/minute
# RATE_LIMIT_PHOTOMETRY=20/minute
# CACHE_DIR=.cache
# LOG_LEVEL=INFO
